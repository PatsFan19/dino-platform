{
  "expo": {
    "name": "Dino World",
    "slug": "dino-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dinoworld",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A8C4E"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dinasour.dinoapp",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A8C4E"
      },
      "package": "com.dinasour.dinoapp",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Dino Explorer — Learn About Dinosaurs!",
      "shortName": "Dino Explorer",
      "description": "Discover amazing dinosaurs! Learn fun facts, take quizzes, and dig for fossils. Free, safe, and ad-free for kids ages 4–9.",
      "themeColor": "#1A8C4E",
      "backgroundColor": "#FFFDF5",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#1A8C4E",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
